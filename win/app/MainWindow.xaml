<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BowtieVC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="蝴蝶结变声器">


    <Grid x:Name="RootGrid" Padding="0">
    <Grid.Resources>
        <LinearGradientBrush x:Key="BowtieBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8465F" Offset="0"/>
            <GradientStop Color="#B92946" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="PulseStory" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity"
                             From="0.75" To="0.15" Duration="0:0:1.1" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:1.1" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" Spacing="14" Padding="32,24,32,28" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,6">
                    <Path Width="44" Height="30" Stretch="Uniform" Fill="{StaticResource BowtieBrush}"
                          Data="M 2,2 L 19,12 L 2,22 Z M 42,2 L 25,12 L 42,22 Z M 19,9 h 6 v 6 h -6 Z"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="蝴蝶结变声器" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="实时音色转换 · MeanVC2 引擎" FontSize="12" Opacity="0.55" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="音色" FontSize="13" FontWeight="SemiBold" Opacity="0.65"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CardCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="CardCombo_SelectionChanged"/>
                            <Button x:Name="AuditionBtn" Grid.Column="1" Content="试听" Click="AuditionBtn_Click" IsEnabled="False"/>
                        </Grid>
                        <Button x:Name="CloneBtn" Content="＋ 克隆新音色…" Click="CloneBtn_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="设备与引擎" FontSize="13" FontWeight="SemiBold" Opacity="0.65"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输入设备" VerticalAlignment="Center"/>
                            <ComboBox x:Name="InCombo" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140"
                                      SelectionChanged="DeviceCombo_SelectionChanged"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出设备" VerticalAlignment="Center"/>
                            <ComboBox x:Name="OutCombo" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140"
                                      SelectionChanged="DeviceCombo_SelectionChanged"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="引擎档位" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModeCombo" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140"
                                      SelectionChanged="ModeCombo_SelectionChanged">
                                <ComboBoxItem Content="40ms 快（低延迟）" Tag="0"/>
                                <ComboBoxItem Content="160ms 稳（高质量）" Tag="1"/>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音频接口" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AudioInfoText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7"
                                       TextWrapping="Wrap" Text="WASAPI 共享模式"/>
                        </Grid>
                        <Grid x:Name="CableRow" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="虚拟声卡" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="未检测到虚拟声卡（VB-Cable / Voicemeeter）" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Foreground="OrangeRed"/>
                            <Button x:Name="InstallCableBtn" Grid.Column="2" Content="安装" Click="InstallCableBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
                    <Grid>
                        <Ellipse x:Name="GlowRing" Width="210" Height="64" Fill="{StaticResource BowtieBrush}" Opacity="0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="ToggleBtn" Content="开始变声" FontSize="18" FontWeight="SemiBold"
                                Padding="48,12" HorizontalAlignment="Center" Click="ToggleBtn_Click" IsEnabled="False"
                                CornerRadius="29" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F0556E" Offset="0"/>
                                    <GradientStop Color="#C22E4C" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Opacity="0.75" Text="正在初始化引擎…" TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <Expander Header="更多参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="0,6,0,4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预缓冲 (ms)" VerticalAlignment="Center"/>
                                <Slider x:Name="PreRollSlider" Grid.Column="1" Maximum="120" Minimum="10" Value="40" StepFrequency="10" MinWidth="140"
                                        ValueChanged="Param_ValueChanged" IsThumbToolTipEnabled="False"/>
                                <TextBlock x:Name="PreRollVal" Grid.Column="2" Text="40" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="接缝淡入淡出 (ms)" VerticalAlignment="Center"/>
                                <Slider x:Name="FadeSlider" Grid.Column="1" Maximum="20" Minimum="0" Value="2" StepFrequency="1" MinWidth="140"
                                        ValueChanged="Param_ValueChanged" IsThumbToolTipEnabled="False"/>
                                <TextBlock x:Name="FadeVal" Grid.Column="2" Text="2" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="输入增益" VerticalAlignment="Center"/>
                                <Slider x:Name="InGainSlider" Grid.Column="1" Maximum="200" Minimum="50" Value="100" StepFrequency="5" MinWidth="140"
                                        ValueChanged="Param_ValueChanged" IsThumbToolTipEnabled="False"/>
                                <TextBlock x:Name="InGainVal" Grid.Column="2" Text="100%" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="输出增益" VerticalAlignment="Center"/>
                                <Slider x:Name="OutGainSlider" Grid.Column="1" Maximum="200" Minimum="50" Value="100" StepFrequency="5" MinWidth="140"
                                        ValueChanged="Param_ValueChanged" IsThumbToolTipEnabled="False"/>
                                <TextBlock x:Name="OutGainVal" Grid.Column="2" Text="100%" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="引擎线程数" VerticalAlignment="Center"/>
                                <Slider x:Name="ThreadsSlider" Grid.Column="1" Maximum="4" Minimum="1" Value="2" StepFrequency="1" MinWidth="140"
                                        ValueChanged="Param_ValueChanged" IsThumbToolTipEnabled="False"/>
                                <TextBlock x:Name="ThreadsVal" Grid.Column="2" Text="2" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="增益拖动立即生效；预缓冲/线程数下次开始变声时生效。参数自动保存。"
                                       Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
